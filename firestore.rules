rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }

    function myUserData() {
      return get(myUserPath()).data;
    }

    function isActiveUser() {
      return myUserExists() && (!('active' in myUserData()) || myUserData().active != false);
    }

    function myRole() {
      return myUserExists() ? myUserData().role : null;
    }

    function myCompanyId() {
      return myUserExists() && ('company_ID' in myUserData()) ? myUserData().company_ID : null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperuser() {
      return signedIn() && myRole() == 'superuser' && isActiveUser();
    }

    function isManager() {
      return signedIn() && myRole() == 'manager' && isActiveUser();
    }

    function isSuperuserOrManager() {
      return isSuperuser() || isManager();
    }

    function isSupervisor() {
      return signedIn() && myRole() == 'supervisor' && isActiveUser();
    }

    function isEncoder() {
      return signedIn() && myRole() == 'encoder' && isActiveUser();
    }

    function sameCompany(data) {
      return myCompanyId() != null &&
        ('company_ID' in data) &&
        data.company_ID == myCompanyId();
    }

    function isSupervisorOf(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return isSupervisor() &&
        exists(userPath) &&
        get(userPath).data.supervisorId == request.auth.uid;
    }

    function isEncoderOf(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return isEncoder() &&
        exists(userPath) &&
        get(userPath).data.encoderId == request.auth.uid;
    }

    function isValidAnnouncementWindow(data) {
      return data.startAt is timestamp &&
        data.endAt is timestamp &&
        data.startAt <= data.endAt;
    }

    function isOwnedAgileDoc(docId) {
      return signedIn() && docId.matches('^.+_' + request.auth.uid + '$');
    }

    function isSafeOwnerUserUpdate() {
      let allowedKeys = [
        'fcmToken',
        'fcmTokenUpdatedAt',
        'profilePic',
        'logoutRequestPending',
        'logoutRequestApproved',
        'logoutRequestStatus',
        'logoutRequestedAt',
        'logoutResolvedAt',
        'logoutResolvedBy',
        'logoutResolvedByName'
      ];
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let safeLogoutApproval =
        !affected.hasAny(['logoutRequestApproved']) ||
        request.resource.data.logoutRequestApproved == false;
      let safeLogoutStatus =
        !affected.hasAny(['logoutRequestStatus']) ||
        request.resource.data.logoutRequestStatus == null ||
        request.resource.data.logoutRequestStatus == 'pending';
      let safeResolutionClear =
        (!affected.hasAny(['logoutResolvedAt']) || request.resource.data.logoutResolvedAt == null) &&
        (!affected.hasAny(['logoutResolvedBy']) || request.resource.data.logoutResolvedBy == null) &&
        (!affected.hasAny(['logoutResolvedByName']) || request.resource.data.logoutResolvedByName == null);
      return affected.hasOnly(allowedKeys) &&
        safeLogoutApproval &&
        safeLogoutStatus &&
        safeResolutionClear;
    }

    function isSafeSalesmanRouteUpdate() {
      let unchangedCore = request.resource.data.salesmanId == resource.data.salesmanId &&
        request.resource.data.supervisorId == resource.data.supervisorId &&
        request.resource.data.date == resource.data.date;
      let noSelfRetakeApproval =
        (request.resource.data.firstRetakeApproved == resource.data.firstRetakeApproved ||
          request.resource.data.firstRetakeApproved == false) &&
        (request.resource.data.lastRetakeApproved == resource.data.lastRetakeApproved ||
          request.resource.data.lastRetakeApproved == false);
      let validTransactions = !('transactions' in request.resource.data) ||
        (request.resource.data.transactions is list &&
          (!('transactions' in resource.data) ||
            request.resource.data.transactions.size() >= resource.data.transactions.size()));
      return unchangedCore && noSelfRetakeApproval && validTransactions;
    }

    function isSafeEncoderRouteUpdate() {
      let unchangedCore = request.resource.data.salesmanId == resource.data.salesmanId &&
        request.resource.data.supervisorId == resource.data.supervisorId &&
        request.resource.data.date == resource.data.date;
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let validTransactions = request.resource.data.transactions is list &&
        (!('transactions' in resource.data) ||
          request.resource.data.transactions.size() == resource.data.transactions.size());
      return unchangedCore && affected.hasOnly(['transactions']) && validTransactions;
    }

    function isSafeSalesmanBookletUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let unchangedIdentity = request.resource.data.salesmanId == resource.data.salesmanId &&
        request.resource.data.revision == resource.data.revision &&
        request.resource.data.booklets is list &&
        (!('booklets' in resource.data) ||
          request.resource.data.booklets.size() == resource.data.booklets.size());
      return affected.hasOnly(['booklets', 'recentVoids', 'updatedAt']) &&
        unchangedIdentity;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow update: if (isOwner(userId) && isActiveUser() && isSafeOwnerUserUpdate()) ||
        isSuperuser();

      allow create: if isSuperuser();
      allow delete: if isSuperuser();

      match /notifications/{notificationId} {
        allow read: if signedIn() && (
          isOwner(userId) ||
          isSuperuserOrManager() ||
          isSupervisorOf(userId)
        );
        allow create: if isSuperuserOrManager() || isSupervisorOf(userId);
        allow update: if (isOwner(userId) && isActiveUser()) ||
          isSuperuserOrManager() ||
          isSupervisorOf(userId);
        allow delete: if isSuperuserOrManager() || isSupervisorOf(userId);
      }
    }

    match /announcements/{announcementId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser() && (
        (isSuperuserOrManager() &&
          request.resource.data.createdBy == request.auth.uid &&
          (request.resource.data.creatorRole == 'superuser' || request.resource.data.creatorRole == 'manager') &&
          isValidAnnouncementWindow(request.resource.data)) ||
        (isSupervisor() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.creatorRole == 'supervisor' &&
          isValidAnnouncementWindow(request.resource.data))
      );

      allow delete: if isActiveUser() && (
        isSuperuserOrManager() || resource.data.createdBy == request.auth.uid
      );

      allow update: if isActiveUser() &&
        (isSuperuserOrManager() || resource.data.createdBy == request.auth.uid) &&
        isValidAnnouncementWindow(request.resource.data);

      match /likes/{userId} {
        allow read: if isActiveUser();
        allow create, update, delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    match /company_ID/{companyDocId} {
      allow read: if isActiveUser();
      allow create: if isSuperuser();
      allow update: if isSuperuser();
      allow delete: if isSuperuser();
    }

    match /settings/{document=**} {
      allow read: if signedIn();
      allow write: if isSuperuser();
    }

    match /routes/{routeId} {
      allow create: if isActiveUser() && (
        isSuperuserOrManager() ||
        (request.resource.data.salesmanId == request.auth.uid &&
          request.resource.data.date is string &&
          request.resource.data.firstRetakeApproved == false &&
          request.resource.data.lastRetakeApproved == false)
      );

      allow read: if isActiveUser() && (
        isSuperuserOrManager() ||
        resource.data.salesmanId == request.auth.uid ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid) ||
        (isEncoderOf(resource.data.salesmanId))
      );

      allow update: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid &&
          request.resource.data.salesmanId == resource.data.salesmanId &&
          request.resource.data.date == resource.data.date) ||
        (isEncoderOf(resource.data.salesmanId) && isSafeEncoderRouteUpdate()) ||
        (resource.data.salesmanId == request.auth.uid && isSafeSalesmanRouteUpdate())
      );

      allow delete: if isSuperuser();
    }

    match /si_booklets/{salesmanId} {
      allow read: if isActiveUser() && (
        isSuperuserOrManager() ||
        isOwner(salesmanId) ||
        isSupervisorOf(salesmanId) ||
        isEncoderOf(salesmanId)
      );

      allow create: if isActiveUser() && (
        isSuperuser() ||
        isEncoderOf(salesmanId)
      );

      allow update: if isActiveUser() && (
        isSuperuser() ||
        isEncoderOf(salesmanId) ||
        (isOwner(salesmanId) && isSafeSalesmanBookletUpdate())
      );

      allow delete: if isSuperuser();
    }

    match /si_booklet_registry/{companyId} {
      allow read: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isEncoder() && myCompanyId() == companyId)
      );

      allow create, update: if isActiveUser() && (
        isSuperuser() ||
        (isEncoder() && myCompanyId() == companyId &&
          request.resource.data.company_ID == companyId)
      );

      allow delete: if isSuperuser();
    }

    match /agile_targets/{targetId} {
      allow read: if isActiveUser() && (
        isSuperuserOrManager() ||
        isOwnedAgileDoc(targetId) ||
        (isSupervisor() && resource != null && resource.data.supervisorId == request.auth.uid)
      );

      allow create: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isSupervisor() &&
          request.resource.data.supervisorId == request.auth.uid &&
          isSupervisorOf(request.resource.data.salesmanId))
      );

      allow update: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid &&
          request.resource.data.supervisorId == request.auth.uid &&
          request.resource.data.salesmanId == resource.data.salesmanId &&
          isSupervisorOf(request.resource.data.salesmanId))
      );

      allow delete: if isSuperuser();
    }

    match /agile_submissions/{submissionId} {
      allow read: if isActiveUser() && (
        isSuperuserOrManager() ||
        isOwnedAgileDoc(submissionId) ||
        (isSupervisor() && resource != null && resource.data.supervisorId == request.auth.uid)
      );

      allow create: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isOwnedAgileDoc(submissionId) &&
          request.resource.data.salesmanId == request.auth.uid)
      );

      allow update: if isActiveUser() && (
        isSuperuserOrManager() ||
        (isOwnedAgileDoc(submissionId) &&
          request.resource.data.salesmanId == request.auth.uid &&
          request.resource.data.salesmanId == request.auth.uid &&
          resource.data.submitted != true)
      );

      allow delete: if isSuperuser();
    }
  }
}
