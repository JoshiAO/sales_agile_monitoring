rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Profile pictures: each user may only write their own image file (<10MB).
    match /profile_pictures/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        (request.resource == null || isValidImageUpload());
    }

    // Route images: each salesman may only write to their own folder (<10MB).
    match /route_images/{salesmanId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == salesmanId &&
        (request.resource == null || isValidImageUpload());
    }

    // Announcement images: authenticated image uploads (<10MB); tighten write roles once custom claims are provisioned.
    match /announcements/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.resource == null || isValidImageUpload());
    }
  }
}
